# Spring datasource
DB_URL=jdbc:postgresql://localhost:5432/supportdb
DB_USERNAME=postgres
DB_PASSWORD=replace-with-a-strong-local-password

# PostgreSQL container
POSTGRES_DB=supportdb

# pgAdmin container
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace-with-a-different-strong-local-password

# JWT signing key: Base64-encoded value containing at least 32 random bytes
JWT_SECRET=replace-with-a-base64-encoded-256-bit-secret

# OpenAI
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_CHAT_MAX_COMPLETION_TOKENS=600
OPENAI_CHAT_REASONING_EFFORT=low

# Local document storage
DOCUMENT_STORAGE_PATH=./data/documents
DOCUMENT_MAX_FILE_SIZE=10MB
DOCUMENT_MAX_REQUEST_SIZE=11MB

# Optional RAG tuning
RAG_CHUNK_TARGET_TOKENS=500
RAG_CHUNK_MINIMUM_SIZE_CHARACTERS=200
RAG_CHUNK_MINIMUM_LENGTH_TO_EMBED=5
RAG_MAX_CHUNKS_PER_PAGE=100
RAG_EMBEDDING_BATCH_SIZE=100
RAG_SEARCH_DEFAULT_RESULTS=5
RAG_SEARCH_MINIMUM_SIMILARITY=0.70

# Optional conversation context limits
CONVERSATION_HISTORY_MAX_MESSAGES=10
CONVERSATION_HISTORY_MAX_CHARACTERS=12000

# Optional API documentation switches
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true
